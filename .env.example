# Environment variable template
#
# NOTE: Cloudflare Pages deployment does NOT read this file. Pages bindings
# (KV `img_url`, R2) and env vars are configured in the Cloudflare dashboard
# or via wrangler. Treat this file as a checklist of the variables the Pages
# runtime actually reads.

PUBLIC_BASE_URL=

# Admin auth (set both to enable login)
BASIC_USER=admin
BASIC_PASS=change_this_password

# Guest upload policy（可在管理后台随时改并即时生效，这里只是环境变量基线）
GUEST_UPLOAD=false
GUEST_MAX_FILE_SIZE=5242880
GUEST_DAILY_LIMIT=10

# KV 低写入模式（优化项，默认关闭）
#
# 设为 true 后：
#   1) API Token 的使用统计采样间隔由 60s 提升到 1h，遥测写入量下降约 98%；
#   2) 上传时不再写入 Telegram 文件元数据 —— 这会显著减少 KV 写入，
#      但副作用是该文件不会出现在管理后台/画廊的文件列表中
#      （只能通过直链访问）。依赖列表管理功能时请保持 false。
#
# 安全性不受影响：API Token 校验、鉴权、封禁、白名单、限额判断
# 全部不依赖上述两处写入，仍照常读取 KV。
#
# MINIMIZE_KV_WRITES=false

# Telegram bootstrap
TG_BOT_TOKEN=
TG_CHAT_ID=
CUSTOM_BOT_API_URL=https://api.telegram.org

# R2 binding name (Pages binding, not a secret)
R2_BUCKET=

# S3-compatible bootstrap
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Discord bootstrap
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# HuggingFace bootstrap
HF_TOKEN=
HF_REPO=

# WebDAV bootstrap
WEBDAV_BASE_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
WEBDAV_BEARER_TOKEN=
WEBDAV_ROOT_PATH=

# GitHub bootstrap
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_MODE=releases
GITHUB_PREFIX=
GITHUB_RELEASE_TAG=
GITHUB_BRANCH=
GITHUB_API_BASE=https://api.github.com

# ─────────────────────────────────────────────────────────────
# 以下变量「部署时都不用填」——可在管理后台（设置面板）随时改并即时生效
# （写入 KV 的运行时配置，优先级高于环境变量，无需重新部署）
# ─────────────────────────────────────────────────────────────

# API v1 CORS allow-list for browser clients (server-to-server agents need none)
# Comma-separated origins; trailing slashes are normalized. Leave empty to send
# no CORS headers at all. Example:
# API_CORS_ORIGINS=https://app.example.com,https://dashboard.example.com
# 也可后台设置（cors 组），留空即可，部署后用后台填。
API_CORS_ORIGINS=

# 分片上传暂存位置：auto（有 R2 就用 R2）/ r2 / kv
# 也可后台设置（upload 组），留空即 auto。
# CHUNK_BACKEND=auto
