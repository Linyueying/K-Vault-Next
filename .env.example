# ============================================================
# K-Vault-Next 环境变量清单
#
# ⚠️ Cloudflare Pages **不读** .env 文件。这里只是「需要配什么」的清单，
#    实际值请配在 Cloudflare Dashboard（Pages → Settings → Environment
#    variables）或 wrangler 里。
#
#    KV 与 R2 是「绑定」不是环境变量，在 Settings → Functions 里绑定：
#      · KV  变量名必须叫 img_url  （必需，写错整个项目跑不起来）
#      · R2  变量名必须叫 R2_BUCKET（强烈推荐，不绑则单文件 ≤40MB）
#
# ✅ 部署最小集 = 第 1 部分（管理员账密）+ 第 2 部分（7 个后端里选 1 个）。
#    其余全部可留空；第 4 部分还能在管理后台改，改完即时生效、无需重新部署。
#
# 💡 变量名大小写：Telegram 等变量历史上存在两种写法（TG_Bot_Token /
#    TG_BOT_TOKEN）。现在**任意一种写法都会被自动识别**，填一个即可，
#    无需像以前那样「两个都写上」。
# ============================================================


# ── 1. 管理员账密（公网部署必填）────────────────────────────
# 两者都设置，管理接口（/api/manage/**、/api/admin/**）才开放。
# 不设则管理接口一律 503 ADMIN_AUTH_NOT_CONFIGURED（fail-closed，不开放给公网）。
BASIC_USER=admin
BASIC_PASS=change_this_password


# ── 2. 存储后端：7 选 1 ─────────────────────────────────────
# 只填你实际要用的那一组，其余整段删掉即可。
# 默认后端是 Telegram；请求指定的后端未配置时回落 Telegram（变量缺失会直接报错，
# 不会静默降级到其他后端）。


## 【A】Telegram（默认后端，免费；单文件上限 20MB）
TG_Bot_Token=
TG_Chat_ID=
# 可选：自部署 Bot API 服务器地址
CUSTOM_BOT_API_URL=https://api.telegram.org


## 【B】Cloudflare R2（推荐；单文件上限 10GB，支持原生分片）
# 这是 Pages 绑定名，不是环境变量：在 Settings → Functions → R2 bucket bindings
# 里绑定，变量名必须是 R2_BUCKET。这里写出来仅供清单参考。
# R2_BUCKET=


## 【C】S3 兼容存储（AWS S3 / MinIO / BackBlaze B2 / 阿里云 OSS 等；40MB）
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=


## 【D】Discord（25MB）
# 二选一：Bot Token + Channel ID，或仅 Webhook URL
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=
# DISCORD_WEBHOOK_URL=


## 【E】HuggingFace Datasets（35MB）
# HF_REPO 是 dataset 仓库（owner/name），不是 model 仓库
# HF_TOKEN=
# HF_REPO=


## 【F】WebDAV（40MB）
# 认证二选一：用户名+密码，或 Bearer Token
# WEBDAV_BASE_URL=
# WEBDAV_USERNAME=
# WEBDAV_PASSWORD=
# WEBDAV_BEARER_TOKEN=      （短名 WEBDAV_TOKEN 同样识别）
# WEBDAV_ROOT_PATH=


## 【G】GitHub（contents 模式 20MB / releases 模式 40MB）
# GITHUB_REPO=
# GITHUB_TOKEN=
# GITHUB_MODE=releases
# GITHUB_PREFIX=
# GITHUB_RELEASE_TAG=
# GITHUB_BRANCH=
# GITHUB_API_BASE=https://api.github.com


# ── 3. 功能开关（可选，都有默认值）──────────────────────────
# 生成绝对直链用的站点地址；留空则用请求 origin
PUBLIC_BASE_URL=

# 签名直链的 HMAC 密钥；留空时依次回落 TG_Bot_Token → 内置值
# （兼容名 TG_FILE_URL_SECRET 同样识别）
FILE_URL_SECRET=

# Telegram 上传成功后是否发通知（兼容名 TELEGRAM_UPLOAD_NOTIFY）
TG_UPLOAD_NOTIFY=true
# Telegram Webhook 校验密钥；未设置时 webhook 不做校验（兼容名 TG_WEBHOOK_SECRET）
TELEGRAM_WEBHOOK_SECRET=
# off/none/minimal 关闭 KV 元数据写入（省写入，但后台列表与删除会受影响）
TELEGRAM_METADATA_MODE=
# 设为 signed 强制签名直链
TELEGRAM_LINK_MODE=

# KV 低写入模式（优化项，默认关闭）：Telegram 走签名直链且不写 KV 元数据。
# 副作用：该文件不会出现在管理后台/画廊列表中（只能直链访问）。
# 安全性不受影响——API Token 校验、鉴权、封禁、限额判断都不依赖这两处写入。
# MINIMIZE_KV_WRITES=false


# ── 4. 以下「部署时都不用填」────────────────────────────────
# 可在管理后台（设置面板）随时修改，写入 KV 后即时生效，无需重新部署。
# 环境变量只是「从未在后台保存过」时的基线值。

# 访客上传策略
GUEST_UPLOAD=false
GUEST_MAX_FILE_SIZE=5242880
GUEST_DAILY_LIMIT=10

# API v1 CORS 白名单，逗号分隔；`*` 表示任意来源；留空不发 CORS 头
# 注意：MCP 端点（/mcp）的跨域也复用这一份白名单，不另设变量。
# API_CORS_ORIGINS=https://app.example.com,https://dashboard.example.com

# ── MCP（Model Context Protocol）端点 ──────────────────────
# 是否开启 POST /mcp（JSON-RPC 2.0，Streamable HTTP，无状态）。
# 默认 **false = 关闭**，此时 /mcp 返回 404，等同不存在（fail-closed：
# 新增的网络面不应因为「部署时忘了配」而自动对公网敞开）。
# 开启后仍走与 /api/v1 完全相同的 API Token 鉴权、scope 与策略体系。
#
# ⚠️ 本变量是**部署期基线**，会被后台覆盖：
#   管理后台 → 系统设置 → MCP 端点 可在线开关，并可逐个体禁用具体工具。
#   后台保存的值（KV）优先于这里；点「恢复默认」即回退到本变量。
#   若希望「部署方总闸」优先于站点管理员，请注意这里的语义并非如此。
#
# 生效时机：/mcp 的开关判定**每个请求都回源一次**（KV 覆盖 > 本变量，带 30 秒
# isolate 缓存），因此后台改完开关会真正立即生效、且不会随 isolate 漂移。
# 取值兼容 true / 1 / yes / on（大小写不敏感），老部署写 mcp_enabled=1 也认。
#
# 说明：协议版本白名单、单次调用超时等目前均使用内置默认值，未开放为
# 环境变量——避免出现「配了却不生效」的假配置项。确有需要时再引入。
# 同理，工具级禁用清单没有环境变量形态（多值集合用逗号串表达既难读
# 又难校验），只在后台维护。
# MCP_ENABLED=false

# 分片上传暂存位置：auto（有 R2 就用 R2）/ r2 / kv
# CHUNK_BACKEND=auto

# WebDAV 服务端（把本站当作 WebDAV 主机，供资源管理器 / Finder / 手机 App 挂载）。
# 与上面【F】的 WebDAV **客户端**后端完全无关：那是「本站往别处传」，
# 这是「别人往本站传」。账号密码独立于 BASIC_USER/BASIC_PASS，可单独设置。
# 全部可在后台「存储 → WebDAV 服务端」在线修改，环境变量只是从未保存过的基线值。
# ⚠️ 生产环境请务必通过 HTTPS 使用（Basic Auth 明文随请求发送）。
WEBDAV_SERVER_ENABLED=false
WEBDAV_SERVER_USERNAME=
# 留空 = 保持已保存的密码不变；要清空密码请改用后台「恢复默认」
WEBDAV_SERVER_PASSWORD=
# 只读模式：仅允许浏览 / 下载，PUT / DELETE / MKCOL / MOVE / COPY 一律 403
WEBDAV_SERVER_READONLY=false
# 文件落库的后端：telegram（默认）/ r2 / s3 / discord / huggingface / github
WEBDAV_SERVER_BACKEND=telegram

# 隔空投送（点对点临时传输）。需要绑定 R2 或 Telegram 才有可用中转节点。
# ⚠️ 下面两个访客开关方向相反，别写反：
#    · GUEST_ALLOWED        访客能否**发起**投送（当发端），默认 false（封闭）
#    · GUEST_RECEIVE_ALLOWED 访客能否**接收**投送（当收端），默认 true（放行）
# 接收端默认放行是刻意的：授权用户开好房间、把连接码/二维码递给对方，
# 对方能不能收就是这次投递的全部意义；且接收不消耗每日次数。
AIRDROP_ENABLED=true
AIRDROP_GUEST_ALLOWED=false
AIRDROP_GUEST_RECEIVE_ALLOWED=true
AIRDROP_MAX_FILE_SIZE=104857600
AIRDROP_DAILY_LIMIT=50
# 房间有效期（分钟），**从发端生成房间那一刻起算**，不是从开始传输起算。
# 默认 5 分钟：投送是"两人同时在线、几秒到几分钟就完成"的操作，5 分钟足够
# 走完「等对方接入 → 选文件 → 传输」。超时后房间立即失效，两端都会停止状态
# 轮询（不再产生 D1 读，免费额度友好），中转节点上的临时文件一并释放。
# 可在后台在线调整（1 ~ 1440 分钟）。
AIRDROP_TTL_MINUTES=5
