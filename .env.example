# ============================================================
# K-Vault-Next 环境变量清单
#
# ⚠️ Cloudflare Pages **不读** .env 文件。这里只是「需要配什么」的清单，
#    实际值请配在 Cloudflare Dashboard（Pages → Settings → Environment
#    variables）或 wrangler 里。
#
#    KV 与 R2 是「绑定」不是环境变量，在 Settings → Functions 里绑定：
#      · KV  变量名必须叫 img_url  （必需，写错整个项目跑不起来）
#      · R2  变量名必须叫 R2_BUCKET（强烈推荐，不绑则单文件 ≤40MB）
#
# ✅ 部署最小集 = 第 1 部分（管理员账密）+ 第 2 部分（7 个后端里选 1 个）。
#    其余全部可留空；第 4 部分还能在管理后台改，改完即时生效、无需重新部署。
#
# 💡 变量名大小写：Telegram 等变量历史上存在两种写法（TG_Bot_Token /
#    TG_BOT_TOKEN）。现在**任意一种写法都会被自动识别**，填一个即可，
#    无需像以前那样「两个都写上」。
# ============================================================


# ── 1. 管理员账密（公网部署必填）────────────────────────────
# 两者都设置，管理接口（/api/manage/**、/api/admin/**）才开放。
# 不设则管理接口一律 503 ADMIN_AUTH_NOT_CONFIGURED（fail-closed，不开放给公网）。
BASIC_USER=admin
BASIC_PASS=change_this_password


# ── 2. 存储后端：7 选 1 ─────────────────────────────────────
# 只填你实际要用的那一组，其余整段删掉即可。
# 默认后端是 Telegram；请求指定的后端未配置时回落 Telegram（变量缺失会直接报错，
# 不会静默降级到其他后端）。


## 【A】Telegram（默认后端，免费；单文件上限 20MB）
TG_Bot_Token=
TG_Chat_ID=
# 可选：自部署 Bot API 服务器地址
CUSTOM_BOT_API_URL=https://api.telegram.org


## 【B】Cloudflare R2（推荐；单文件上限 10GB，支持原生分片）
# 这是 Pages 绑定名，不是环境变量：在 Settings → Functions → R2 bucket bindings
# 里绑定，变量名必须是 R2_BUCKET。这里写出来仅供清单参考。
# R2_BUCKET=


## 【C】S3 兼容存储（AWS S3 / MinIO / BackBlaze B2 / 阿里云 OSS 等；40MB）
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=


## 【D】Discord（25MB）
# 二选一：Bot Token + Channel ID，或仅 Webhook URL
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=
# DISCORD_WEBHOOK_URL=


## 【E】HuggingFace Datasets（35MB）
# HF_REPO 是 dataset 仓库（owner/name），不是 model 仓库
# HF_TOKEN=
# HF_REPO=


## 【F】WebDAV（40MB）
# 认证二选一：用户名+密码，或 Bearer Token
# WEBDAV_BASE_URL=
# WEBDAV_USERNAME=
# WEBDAV_PASSWORD=
# WEBDAV_BEARER_TOKEN=      （短名 WEBDAV_TOKEN 同样识别）
# WEBDAV_ROOT_PATH=


## 【G】GitHub（contents 模式 20MB / releases 模式 40MB）
# GITHUB_REPO=
# GITHUB_TOKEN=
# GITHUB_MODE=releases
# GITHUB_PREFIX=
# GITHUB_RELEASE_TAG=
# GITHUB_BRANCH=
# GITHUB_API_BASE=https://api.github.com


# ── 3. 功能开关（可选，都有默认值）──────────────────────────
# 生成绝对直链用的站点地址；留空则用请求 origin
PUBLIC_BASE_URL=

# 签名直链的 HMAC 密钥；留空时依次回落 TG_Bot_Token → 内置值
# （兼容名 TG_FILE_URL_SECRET 同样识别）
FILE_URL_SECRET=

# Telegram 上传成功后是否发通知（兼容名 TELEGRAM_UPLOAD_NOTIFY）
TG_UPLOAD_NOTIFY=true
# Telegram Webhook 校验密钥；未设置时 webhook 不做校验（兼容名 TG_WEBHOOK_SECRET）
TELEGRAM_WEBHOOK_SECRET=
# off/none/minimal 关闭 KV 元数据写入（省写入，但后台列表与删除会受影响）
TELEGRAM_METADATA_MODE=
# 设为 signed 强制签名直链
TELEGRAM_LINK_MODE=

# KV 低写入模式（优化项，默认关闭）：Telegram 走签名直链且不写 KV 元数据。
# 副作用：该文件不会出现在管理后台/画廊列表中（只能直链访问）。
# 安全性不受影响——API Token 校验、鉴权、封禁、限额判断都不依赖这两处写入。
# MINIMIZE_KV_WRITES=false


# ── 4. 以下「部署时都不用填」────────────────────────────────
# 可在管理后台（设置面板）随时修改，写入 KV 后即时生效，无需重新部署。
# 环境变量只是「从未在后台保存过」时的基线值。

# 访客上传策略
GUEST_UPLOAD=false
GUEST_MAX_FILE_SIZE=5242880
GUEST_DAILY_LIMIT=10

# API v1 CORS 白名单，逗号分隔；`*` 表示任意来源；留空不发 CORS 头
# API_CORS_ORIGINS=https://app.example.com,https://dashboard.example.com

# 分片上传暂存位置：auto（有 R2 就用 R2）/ r2 / kv
# CHUNK_BACKEND=auto
